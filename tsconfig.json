{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "types": [
      "@cloudflare/workers-types",
      "node"
    ],
    "paths": {
      "@rpcTypes/*": [
        "./types/*"
      ],
      "@auth/*": [
        "./auth/*"
      ]
    }
  }
}

